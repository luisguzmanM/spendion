# Server
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/spendion

# Security & Authentication
# ENCRYPTOR_KEY must be at least 16 characters long for simple-encryptor
ENCRYPTOR_KEY=your_secret_encryptor_key_min_16_chars
JWT_KEY=your_jwt_secret_key

# Email Configuration (Nodemailer / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
RESEND_API_KEY=your_resend_api_key

# Environment & Payments (PayPal)
NODE_ENV=dev
PAYPAL_API_SANDBOX=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID_SANDBOX=your_paypal_sandbox_client_id
PAYPAL_SECRET_KEY_SANDBOX=your_paypal_sandbox_secret_key
PAYPAL_API_LIVE=https://api-m.paypal.com
PAYPAL_CLIENT_ID_LIVE=your_paypal_live_client_id
PAYPAL_SECRET_KEY_LIVE=your_paypal_live_secret_key
